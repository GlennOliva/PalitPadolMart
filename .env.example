# Supabase project URL (browser-safe public endpoint)
VITE_SUPABASE_URL=

# Supabase anonymous (publishable) API key for browser clients.
# Never use the service-role key here or anywhere in frontend code.
VITE_SUPABASE_ANON_KEY=

# --- Hosted Phase 7 verification (favorites + inquiries) ---
# Three reusable, CONFIRMED Supabase Auth accounts used only by
# verify-phase7.mjs. The script NEVER creates Auth users via signup; it only
# signs in with these credentials. Keep the real values local (e.g. in the
# gitignored .env.local) and never commit them.
PHASE7_TEST_SELLER_EMAIL=
PHASE7_TEST_SELLER_PASSWORD=

PHASE7_TEST_BUYER_EMAIL=
PHASE7_TEST_BUYER_PASSWORD=

PHASE7_TEST_STRANGER_EMAIL=
PHASE7_TEST_STRANGER_PASSWORD=

# --- Hosted Phase 8 verification (orders + transactions + cart + checkout) ---
# Reuses the confirmed Phase 7 accounts above, plus one additional confirmed
# buyer for the mandatory concurrency test. verify-phase8.mjs NEVER creates
# Auth users; it only signs in with these credentials.
PHASE8_TEST_BUYER_B_EMAIL=
PHASE8_TEST_BUYER_B_PASSWORD=

# Optional: a second CONFIRMED SELLER for the multi-seller checkout section.
# When set, verify-phase8.mjs verifies that one cart checkout across two
# sellers produces one order per seller. When absent, that section SKIPs.
PHASE8_TEST_SELLER_B_EMAIL=
PHASE8_TEST_SELLER_B_PASSWORD=

# --- Hosted Phase 12 verification (notifications) ---
# Required for positive administrator-recipient and seller-status notification
# checks. The verifier reports an explicit SKIP when these are absent.
PHASE12_TEST_ADMIN_EMAIL=
PHASE12_TEST_ADMIN_PASSWORD=

# --- Hosted Phase 13 E2E (administration) ---
# Admin credentials for the Playwright acceptance suite. Must resolve to a
# confirmed account whose profiles.role is 'admin'. Buyer/seller reuse the
# confirmed Phase 7 accounts above.
PHASE13_TEST_ADMIN_EMAIL=
PHASE13_TEST_ADMIN_PASSWORD=

# --- Hosted Phase 14 verification (reporting + analytics) ---
# Optional admin credentials for the marketplace-analytics positive checks and
# the two admin browser journeys. Falls back to PHASE13_TEST_ADMIN_* when not
# set. When absent or invalid the admin-positive checks explicitly SKIP and the
# seller-side checks still run.
PHASE14_TEST_ADMIN_EMAIL=
PHASE14_TEST_ADMIN_PASSWORD=

# --- Hosted Phase 15 verification (admin visualization + report printing) ---
# Optional admin credentials for the Phase 15 dashboard/analytics/report-center
# browser journeys and the marketplace-analytics positive checks. Falls back to
# PHASE14_TEST_ADMIN_* then PHASE13_TEST_ADMIN_* when not set. When absent or
# invalid the admin-positive checks and admin browser journeys explicitly SKIP
# while the public responsive matrix and seller checks still run.
PHASE15_TEST_ADMIN_EMAIL=
PHASE15_TEST_ADMIN_PASSWORD=
